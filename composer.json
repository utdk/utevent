{
  "name": "utexas/utevent",
  "type": "drupal-custom-module",
  "description": "Drupal module that provides an event content type and supporting components for use with the UT Drupal Kit.",
  "keywords": [
    "Drupal"
  ],
  "license": [
    "GPL-2.0-or-later"
  ],
  "homepage": "https://github.austin.utexas.edu/eis1-wcs/utevent",
  "minimum-stability": "dev",
  "support": {
    "issues": "https://github.austin.utexas.edu/eis1-wcs/utevent/issues",
    "source": "https://github.austin.utexas.edu/eis1-wcs/utevent"
  },
  "require": {
    "drupal/addtocal_augment": "1.2.4",
    "drupal/date_augmenter": "1.1.2",
    "drupal/feeds": "3.2.0",
    "drupal/feeds_ex": "1.0.0-beta5",
    "drupal/feeds_tamper": "2.0.0-rc1",
    "drupal/feeds_tamper_media_url": "1.0",
    "drupal/fullcalendar_view": "5.2.5",
    "drupal/smart_date": "4.2.4",
    "utexas/utdk_profile": "^3.29.0 || dev-develop"
  },
  "extra": {
    "patches": {
      "drupal/feeds_tamper_media_url": {
        "Add support for importing alt and title text": "https://git.drupalcode.org/project/feeds_tamper_media_url/-/merge_requests/4.diff"
      }
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "cweagans/composer-patches": true,
      "drupal/core-composer-scaffold": true,
      "composer/installers": true,
      "oomphinc/composer-installers-extender": true
    }
  },
  "prefer-stable": true
}
